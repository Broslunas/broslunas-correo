# MongoDB Atlas Configuration (TCP Connection)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mailservice

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
ALLOWED_USER_EMAIL=your_email@gmail.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required for Google Drive Picker API:
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
NEXT_PUBLIC_GOOGLE_DEVELOPER_KEY=your_google_developer_key_here



# Session Cryptography
# Run 'openssl rand -base64 32' to generate a secure secret
JWT_SECRET=replace_with_a_long_secure_secret_string

# Mailjet API Configuration (v3.1 Send)
MAILJET_API_KEY=tu_mailjet_api_key
MAILJET_API_SECRET=tu_mailjet_api_secret
MAILJET_FROM_EMAIL=yo@midominio.com
MAILJET_FROM_NAME="Tu Nombre Corporativo"

# Cloudflare R2 Storage (S3 API Credentials for Secure Proxy Downloads)
# These are generated in the Cloudflare Dashboard under R2 -> Manage R2 API Tokens
R2_ACCESS_KEY_ID=tu_r2_access_key_id
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key
R2_ENDPOINT=https://tu_account_id.r2.cloudflarestorage.com
R2_BUCKET_NAME=webmail-attachments

# Cloudflare Worker Email Ingress Secret
INGRESS_SECRET=your_ingress_webhook_secret_here

# Web Push VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your_email@domain.com


